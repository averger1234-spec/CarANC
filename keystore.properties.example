# Copy this file to keystore.properties in the project root (gitignored).
# Do NOT commit real passwords or the .jks/.keystore file.
#
# Generate upload key once (example):
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias caranc_upload
#
# storeFile is relative to the project root (or use an absolute path).

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=caranc_upload
keyPassword=CHANGE_ME
